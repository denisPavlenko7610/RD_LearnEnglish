:root {
    background-color: #f5f2e9;
    color: #203b35;
    font-size: 18px;
}

.app {
    flex-grow: 1;
    background-color: #f5f2e9;
    padding: 24px 38px;
}

Label {
    white-space: normal;
    flex-shrink: 0;
}

Button {
    background-color: #fffdf8;
    color: #203b35;
    border-width: 1px;
    border-color: #d8dfd3;
    border-radius: 10px;
    padding: 12px 20px;
    margin: 4px;
    min-height: 46px;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 17px;
}

Button:hover {
    background-color: #e3ece0;
    border-color: #236759;
}

Button:focus {
    border-width: 2px;
    border-color: #236759;
}

Button:active {
    background-color: #d0e1d2;
}

Button:disabled {
    opacity: 0.55;
}

.primary {
    background-color: #236759;
    color: #ffffff;
    border-color: #236759;
    -unity-font-style: bold;
}

.primary:hover {
    background-color: #184e42;
    color: #ffffff;
}

.header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.brand {
    font-size: 21px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.grow {
    flex-grow: 1;
}

.small {
    font-size: 14px;
    color: #64736c;
}

.eyebrow {
    font-size: 13px;
    color: #236759;
    letter-spacing: 1px;
    margin-bottom: 14px;
}

.headline {
    font-size: 39px;
    -unity-font-style: bold;
    margin-bottom: 18px;
}

.subtitle {
    font-size: 18px;
    color: #64736c;
    margin-bottom: 22px;
}

.home-layout {
    flex-shrink: 0;
    flex-direction: row;
    flex-grow: 1;
}

.intro {
    flex-grow: 1;
    flex-basis: 44%;
    padding-right: 36px;
    justify-content: center;
}

.course {
    flex-grow: 1;
    flex-basis: 56%;
    background-color: #fffdf8;
    border-radius: 18px;
    padding: 24px;
}

.tabs {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.tabs Button {
    flex-grow: 1;
    padding: 9px;
    min-width: 52px;
}

.selected {
    background-color: #236759;
    color: #ffffff;
}

.topic-title {
    font-size: 27px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.topic-goal {
    font-size: 17px;
    margin-bottom: 14px;
}

.rule {
    color: #40574e;
    font-size: 17px;
    margin: 12px 0;
}

.row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.pager {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
}

.evidence {
    padding: 15px;
    background-color: #e8eee3;
    border-radius: 10px;
    margin-top: 20px;
    font-size: 16px;
}

.footer {
    margin-top: 16px;
    font-size: 13px;
    color: #64736c;
}

.lesson-content {
    max-width: 940px;
    width: 100%;
    align-self: center;
    padding: 14px 20px;
}

.context {
    font-size: 27px;
    margin: 20px 0;
}

.prompt {
    font-size: 18px;
    color: #64736c;
}

.choices {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.choices Button {
    flex-grow: 1;
    flex-basis: 45%;
    font-size: 21px;
    min-height: 60px;
}

TextField {
    margin: 14px 0;
    color: #203b35;
    font-size: 23px;
}

TextField > .unity-text-field__label {
    font-size: 15px;
    color: #64736c;
    margin-bottom: 8px;
}

TextField .unity-text-field__input {
    background-color: #ffffff;
    color: #203b35;
    padding: 14px;
    border-width: 1px;
    border-color: #a9bdb0;
    border-radius: 8px;
    min-height: 54px;
}

TextField:focus .unity-text-field__input {
    border-color: #236759;
    border-width: 2px;
}

.feedback {
    background-color: #e6eee1;
    border-radius: 12px;
    padding: 18px;
    margin: 16px 0;
}

.feedback.incorrect {
    background-color: #f8e8df;
}

.feedback-title {
    font-size: 21px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.feedback-body {
    font-size: 18px;
    margin: 5px 0;
}

.status {
    font-size: 15px;
    color: #64736c;
    margin: 10px 0;
}

.reference {
    background-color: #eee8d8;
    padding: 16px;
    margin-top: 14px;
    border-radius: 12px;
}

.context-image {
    flex-shrink: 0;
    background-image: url("project://database/Assets/_Project/Art/CafeConversation.png");
    height: 160px;
    margin: 10px 0;
    border-radius: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.hidden {
    display: none;
}

.compact .app {
    padding: 12px 18px;
}

.compact .home-layout {
    flex-direction: column;
    flex-grow: 0;
}

.compact .intro, .compact .course {
    flex-basis: auto;
    flex-shrink: 0;
}

.compact .header {
    flex-direction: column;
    align-items: flex-start;
}

.compact .intro {
    padding-right: 0;
    margin-bottom: 18px;
}

.compact .headline {
    font-size: 28px;
}

.compact .context {
    font-size: 23px;
}

.compact .context-image {
    height: 100px;
}

.boot {
    justify-content: center;
    align-items: center;
}

.boot Label {
    max-width: 680px;
    margin: 18px;
    -unity-text-align: middle-center;
}

.unity-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.unity-scroll-view__content-viewport {
    overflow: hidden;
    min-height: 0;
}

.unity-scroller--vertical {
    width: 12px;
}

.unity-scroller__slider .unity-base-slider__tracker {
    background-color: #e4e8df;
}

.unity-scroller__slider .unity-base-slider__dragger {
    background-color: #a6b9ac;
    border-radius: 6px;
}

.unity-scroller__low-button, .unity-scroller__high-button {
    display: none;
}
